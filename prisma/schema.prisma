generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  year      Int
  referrer  String
  notes     String   @default("")
  createdAt DateTime @default(now())
  tasks     Task[]
}

model Task {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title     String
  category  String
  status    String   @default("NOT_STARTED")
  date      String
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Work Experience extra fields
  weCompany            String  @default("")
  weContactPhone       String  @default("")
  weContactEmail       String  @default("")
  weStartDate          String  @default("")
  weEndDate            String  @default("")
  weSPR                Boolean @default(false)
  weMyWorkExperience   Boolean @default(false)
  weMedicalDocs        Boolean @default(false)
  weWorkplaceVisited   Boolean @default(false)
  weSafetyGuideParent  Boolean @default(false)
  weSafetyGuideEmployer Boolean @default(false)
}
